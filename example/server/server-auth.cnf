#
# OpenSSL configuration for SERVER certificates (serverAuth EKU)
# Used for FreeRADIUS and other servers that need server authentication
# This config provides the extensions to be added to certificates
#

[ req ]
default_bits           = 2048
distinguished_name     = req_distinguished_name
req_extensions         = v3_server_req

[ req_distinguished_name ]
# Placeholder - actual DN comes from CSR

[ v3_server_req ]
# Extensions for server certificates
basicConstraints       = CA:FALSE
keyUsage               = critical, digitalSignature, keyEncipherment, dataEncipherment
extendedKeyUsage       = critical, serverAuth
subjectKeyIdentifier   = hash
subjectAltName         = @alt_names

[alt_names]
DNS.1 = localhost
IP.1  = 127.0.0.1

[ server_cert ]
# Section used when 'ca' signs a server request
basicConstraints       = CA:FALSE
keyUsage               = critical, digitalSignature, keyEncipherment, dataEncipherment
extendedKeyUsage       = critical, serverAuth
subjectKeyIdentifier   = hash
authorityKeyIdentifier = keyid:always
crlDistributionPoints  = URI:http://example.com/crl.pem
